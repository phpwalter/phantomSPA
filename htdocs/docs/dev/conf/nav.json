{
  "$schema": "https://example.com/phantom/nav.schema.json",
  "basePath": "/docs/dev/",
  "contentRoot": "/docs/dev/pages/",
  "stylesRoot": "/docs/dev/css/",
  "routes": [

    {
      "path": "/",
      "file": "intro.md",
      "title": "Intro",
      "icon": "📖",
      "css": "/docs/dev/css/intro.css"
    },

    {
      "path": "/getting-started",
      "title": "Getting Started",
      "icon": "🚀",
      "file": "getting-started.md",
      "css": "/docs/dev/css/getting-started.css",
      "lazy": false,
      "children": [
        { "path": "/setup", "title": "Setup",         "file": "setup.md" },
        { "path": "/cli",   "title": "Using the CLI", "file": "cli.md" }
      ]
    },

    {
      "path": "/api",
      "title": "API Reference",
      "icon": "📚",
      "file": "api-ref.md",
      "css": "/docs/dev/css/api.ref.css"
    },

    {
      "path": "/routing",
      "title": "Routing",
      "icon": "🛣️",
      "file": "routing.md",
      "css": "/docs/dev/css/routing.css"
    },
    { "path": "/html-injection",  "title": "HTML Injection",   "icon": "💉", "file": "html-injection.md"},
    { "path": "/events",          "title": "Events",           "icon": "💡", "file": "events.md"},
    { "path": "/plugins",         "title": "Plugins",          "icon": "🧩", "file": "plugins.md"},
    { "path": "/examples",        "title": "Examples",         "icon": "💡", "file": "examples.md"},
    { "path": "/advanced",        "title": "Advanced",         "icon": "🎮", "file": "advanced.md"},

    { "path": "*",                "title": "Not found",        "icon": "❓", "file": "404.html" }
  ]
}
