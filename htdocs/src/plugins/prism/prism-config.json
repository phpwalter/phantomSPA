{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$comment": "PhantomSPA Prism Plugin Configuration - Directive definitions and activation rules",

    "storageKey": "prismConfig",

    "deprecatedDirectives": {
        "$comment": "Directives that should not be used directly - PhantomSPA handles these via the hybrid approach",
        "$note": "The toolbar plugin is now REQUIRED and loaded from CDN. PhantomSPA registers custom buttons via Prism.plugins.toolbar.registerButton() API.",
        "show-language": {
            "reason": "PhantomSPA registers a custom 'phantomspa-language' button with the toolbar that includes language icons. Do not load the CDN show-language plugin.",
            "replacement": "Language label with icon is registered automatically via toolbar API.",
            "severity": "info"
        },
        "copy-to-clipboard": {
            "reason": "PhantomSPA registers a custom 'phantomspa-copy' button with the toolbar that provides enhanced copy feedback. Do not load the CDN copy-to-clipboard plugin.",
            "replacement": "Copy button is registered automatically via toolbar API.",
            "severity": "info"
        },
        "download-button": {
            "reason": "PhantomSPA registers a custom 'phantomspa-download' button with the toolbar that provides a multi-format download menu. Do not load the CDN download-button plugin.",
            "replacement": "Download menu is registered automatically via toolbar API.",
            "severity": "info"
        }
    },

    "defaults": {
        "enableHighlighting": true,
        "showLineNumbers": true,
        "showCopyButton": true,
        "showDownloadButton": true,
        "showLanguageLabel": true,
        "enableLineHighlight": true,
        "enableCommandLine": true
    },

    "globalToggles": {
        "$comment": "Maps config keys to CSS classes applied to document.body for global feature toggling",
        "enableHighlighting": {
            "bodyClass": "prism-no-highlighting",
            "invert": true
        },
        "showLineNumbers": {
            "bodyClass": "prism-no-line-numbers",
            "invert": true
        },
        "showCopyButton": {
            "bodyClass": "prism-no-copy",
            "invert": true
        },
        "showDownloadButton": {
            "bodyClass": "prism-no-download",
            "invert": true
        },
        "showLanguageLabel": {
            "bodyClass": "prism-no-language",
            "invert": true
        },
        "enableLineHighlight": {
            "bodyClass": "prism-no-line-highlight",
            "invert": true
        },
        "enableCommandLine": {
            "bodyClass": "prism-no-command-line",
            "invert": true
        }
    },

    "settingsPanel": {
        "$comment": "Configuration for the settings UI panel",
        "title": "Code Block Settings",
        "options": [
            { "key": "enableHighlighting", "label": "Enable syntax highlighting" },
            { "key": "showLineNumbers", "label": "Show line numbers" },
            { "key": "showCopyButton", "label": "Show copy button" },
            { "key": "showDownloadButton", "label": "Show download button" },
            { "key": "showLanguageLabel", "label": "Show language label" },
            { "key": "enableLineHighlight", "label": "Enable line highlighting" },
            { "key": "enableCommandLine", "label": "Enable command-line prompts" }
        ]
    },

    "globalHighlighting": {
        "$comment": "Rules for applying global config to code blocks without per-block directives",
        "lineNumbers": {
            "configKey": "showLineNumbers",
            "addClass": "line-numbers",
            "conflictsWith": ["command-line"]
        },
        "commandLine": {
            "configKey": "enableCommandLine",
            "removeClass": "command-line",
            "onlyWhenDisabled": true
        }
    },

    "cleanupPatterns": {
        "$comment": "Class patterns to remove when disabling highlighting",
        "classPatterns": ["^line-"],
        "exactClasses": ["command-line"]
    },

    "directives": {
        "line-numbers": {
            "description": "Show line numbers in the gutter",
            "activation": {
                "target": "pre",
                "addClass": "line-numbers"
            }
        },
        "command-line": {
            "description": "Display as command-line interface with prompt",
            "activation": {
                "target": "pre",
                "addClass": "command-line"
            },
            "conflicts": ["line-numbers"]
        },
        "toolbar": {
            "description": "Show the toolbar (required for copy/download/language buttons)",
            "activation": {
                "target": "pre",
                "addClass": "toolbar"
            }
        },
        "copy-to-clipboard": {
            "description": "Show copy button in toolbar",
            "activation": {
                "target": "pre",
                "setAttribute": { "data-prism-copy": "true" }
            },
            "implies": ["toolbar"]
        },
        "download-button": {
            "description": "Show download button in toolbar",
            "activation": {
                "target": "pre",
                "setAttribute": { "data-prism-download": "true" }
            },
            "implies": ["toolbar"],
            "customActivation": "download-button"
        },
        "show-language": {
            "description": "Show language label in toolbar",
            "activation": {
                "target": "pre",
                "setAttribute": { "data-prism-language": "true" }
            },
            "implies": ["toolbar"]
        },
        "treeview": {
            "description": "Display as file/folder tree structure",
            "activation": {
                "target": "pre",
                "setAttribute": { "data-treeview-icons": "none" }
            },
            "flags": {
                "-n": {
                    "description": "Use native Prism icons",
                    "overrideAttribute": { "data-treeview-icons": "native" }
                },
                "-c": {
                    "description": "Use custom PhantomSPA icons",
                    "overrideAttribute": { "data-treeview-icons": "custom" }
                }
            },
            "customActivation": "treeview"
        },
        "match-braces": {
            "description": "Highlight matching braces on hover/click",
            "activation": {
                "target": "code",
                "addClass": "match-braces"
            },
            "flags": {
                "-r": {
                    "description": "Enable rainbow colorization for nested braces",
                    "target": "code",
                    "addClass": "rainbow-braces"
                }
            }
        }
    },

    "parameterizedDirectives": {
        "highlight": {
            "description": "Highlight specific lines (e.g., highlight=2,4-6)",
            "pattern": "^[\\d,\\-]+$",
            "activation": {
                "target": "pre",
                "setAttribute": { "data-line": "{value}" }
            }
        }
    },

    "globalAttributes": {
        "configured": {
            "description": "Marks that this block has per-block configuration",
            "attribute": "data-prism-configured",
            "value": "true"
        }
    },

    "iconSprites": {
        "$comment": "Icon sprite systems for code block headers and treeview",

        "prog-lang-icons": {
            "description": "Programming language icons for code block headers",
            "cssPath": "/src/assets/images/prog.lang-icons/prog.lang-icons.css",
            "linkId": "prism-prog-lang-icons-css",
            "applyTo": "code-headers",
            "iconClassPrefix": "lang-icon",
            "defaultIcon": "lang-icon-json-sm",
            "sizeVariant": "-sm",
            "languageMap": {
                "typescript": "typescript",
                "javascript": "javascript",
                "js": "javascript",
                "jsx": "javascript",
                "tsx": "typescript",
                "css": "css3",
                "scss": "css3",
                "sass": "css3",
                "less": "css3",
                "stylus": "css3",
                "html": "html5",
                "markup": "html5",
                "xml": "html5",
                "svg": "html5",
                "swift": "swift",
                "assemblyscript": "assemblyscript",
                "python": "python",
                "py": "python",
                "c": "c",
                "cpp": "cpp",
                "cxx": "cpp",
                "cc": "cpp",
                "csharp": "csharp",
                "cs": "csharp",
                "mysql": "mysql",
                "java": "java",
                "php": "php",
                "perl": "perl",
                "pl": "perl",
                "sql": "mssql",
                "mssql": "mssql",
                "tsql": "mssql",
                "json": "json",
                "ruby": "ruby",
                "rb": "ruby",
                "markdown": "markdown",
                "md": "markdown",
                "bash": "bash",
                "shell": "bash",
                "sh": "bash",
                "zsh": "bash",
                "fish": "bash",
                "powershell": "bash",
                "apache": "apache",
                "nodejs": "nodejs",
                "node": "node",
                "treeview": "tree",
                "tree": "tree"
            }
        },

        "file-type-icons": {
            "description": "File type icons for treeview blocks",
            "cssPath": "/src/assets/images/file.type-icons/file.type-icons.css",
            "linkId": "prism-file-type-icons-css",
            "applyTo": "treeview",
            "iconClassPrefix": "lang-icon",
            "defaultIcon": "lang-icon-generic-sm",
            "folderIcon": "lang-icon-folder-sm",
            "sizeVariant": "-sm",
            "directoryNames": ["pages", "docs", "public", "src", "assets", "components", "project"],
            "extensionMap": {
                "html5": "html",
                "html": "html",
                "htm": "html",
                "css3": "css",
                "css": "css",
                "scss": "css",
                "sass": "css",
                "less": "css",
                "js": "js",
                "jsx": "js",
                "ts": "js",
                "tsx": "js",
                "json": "json",
                "yml": "json",
                "yaml": "json",
                "csv": "csv",
                "md": "txt",
                "markdown": "txt",
                "txt": "txt",
                "pdf": "pdf",
                "doc": "doc",
                "docx": "doc",
                "xls": "xls",
                "xlsx": "xls",
                "ppt": "ppt",
                "pptx": "ppt",
                "png": "png",
                "jpg": "png",
                "jpeg": "png",
                "gif": "gif",
                "svg": "svg",
                "eps": "eps",
                "php": "php",
                "py": "pyn",
                "python": "pyn",
                "pl": "perl",
                "perl": "perl",
                "zip": "zip",
                "rar": "rar",
                "tar": "zip",
                "gz": "zip",
                "mp3": "mp3",
                "wav": "wav",
                "mov": "mov",
                "avi": "avi",
                "mp4": "avi",
                "exe": "exe",
                "dll": "dll",
                "mod": "mod"
            }
        }
    },

    "dropins": {
        "$comment": "Drop-in modules that extend Prism functionality without modifying core files",

        "custom-headers": {
            "description": "Adds custom headers with language icons, copy button, and download menu to code blocks",
            "module": "./dropins/custom-headers.js",
            "enabled": true,
            "hooks": ["afterHighlight", "onConfigChange"],
            "options": {
                "showLanguageIcon": true,
                "showCopyButton": true,
                "showDownloadMenu": true
            }
        },

        "tree-icons": {
            "description": "Adds file type icons to treeview code blocks",
            "module": "./dropins/tree-icons.js",
            "enabled": true,
            "hooks": ["afterHighlight"],
            "options": {
                "iconSprite": "file-type-icons"
            }
        },

        "icon-sprites": {
            "description": "Loads icon sprite CSS files defined in iconSprites config",
            "module": "./dropins/icon-sprites.js",
            "enabled": true,
            "hooks": ["init"],
            "options": {}
        }
    }
}
