  "meta-charset-required": true,
  "lang-require": true,
  "head-meta-desc-required": true,
  "meta-viewport-required": true,

  "head-script-disabled": true,
  "inline-script-disabled": true,
  "style-disabled": true,
  "inline-style-disabled": true,

  "id-class-ad-disabled": true,
  "href-abs-or-rel": "abs",
  "space-tab-mixed-disabled": "space",

  "banned-tags": ["center", "font", "marquee", "blink"],
