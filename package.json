{
  "name": "phantomspa",
  "version": "0.0.1",
  "description": "A lightweight, configuration-driven SPA kernel.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phpwalter/phantomSPA.git"
  },
  "keywords": [
    "spa",
    "router",
    "framework-agnostic"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node build.mjs",
    "vendor:install": "node scripts/install-vendors.mjs",
    "postinstall": "npm run vendor:install",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./router": {
      "import": "./dist/esm/router.js",
      "default": "./dist/esm/router.js"
    },
    "./spa": {
      "import": "./dist/esm/spa.js",
      "default": "./dist/esm/spa.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^27.1.0"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "marked": "^17.0.0"
  }
}
